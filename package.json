{
  "name": "harness-studio",
  "version": "0.1.0",
  "description": "Lightweight desktop control center for llama.cpp (llama-server): model hub, runtime manager, launcher and live telemetry.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:locales": "node scripts/check-locales.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test:rust": "cargo test --workspace",
    "test:text-tool-calls": "node --test scripts/test-text-tool-calls.mjs scripts/test-tool-guidance.mjs",
    "lint:rust": "cargo clippy --workspace -- -D warnings"
  },
  "license": "MIT",
  "author": "struklabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/struklabs/harness-studio.git"
  },
  "homepage": "https://github.com/struklabs/harness-studio",
  "bugs": {
    "url": "https://github.com/struklabs/harness-studio/issues"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@lucide/svelte": "^1.48.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
