CLAUDE.md
# OS / editor
.DS_Store
Thumbs.db
.idea/

# Dependencies and build output
node_modules
/build
/.svelte-kit
/package
/target/
/src-tauri/binaries/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Environment files and signing keys (never commit secrets)
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# Local runtime data (the app uses the per-user app data dir; these only appear when run from the repo)
/config/
/bin/
/logs/
/models/
/src-tauri/config/
/src-tauri/bin/
/src-tauri/logs/
/src-tauri/models/

# Local scratch space and test artifacts
/scratch/
/test/
*.log
# Real llama-server stderr captures used as failure-classification fixtures.
!crates/harness-core/tests/data/failures/*.log

# Local tooling files
.claude/

# Benchmark suite virtualenv
/bench/compare/.venv/
__pycache__/

# Screenshots written by the UI test scripts
/docs/screenshots/menus-*.png
/docs/screenshots/ui-open/

# Never publish benchmark measurements or generated reports
/docs/benchmarks/

# Control API SDKs: generated from sdk/openapi.json by sdk/generate.mjs
/sdk/typescript/src/schema.ts
/sdk/python/src/harness_studio_api/
